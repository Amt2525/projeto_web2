# Copie para .env e substitua TODOS os valores TROQUE_*. Nada aqui é credencial real.
# Segredos devem ser gerados aleatoriamente (ver docs/setup/ambiente-windows.md).

# Banco (usado pelo docker-compose e pelo back-end)
POSTGRES_USER=solarsystem
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=solarsystem
# A senha aqui deve ser a mesma de POSTGRES_PASSWORD
DATABASE_URL="postgresql://solarsystem:TROQUE_ESTA_SENHA@localhost:5432/solarsystem"

# API
API_PORT=3000
JWT_ACCESS_SECRET="TROQUE_POR_SEGREDO_ALEATORIO_LONGO"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Chave para criptografar credenciais de integrações (gerar aleatória)
CREDENTIALS_ENCRYPTION_KEY="TROQUE_POR_CHAVE_ALEATORIA"

# E-mail (dev: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Simulador (SOMENTE demonstração)
SIMULATOR_PORT=4010
SIMULATOR_BASE_URL="http://localhost:4010"
SIMULATOR_API_KEY="TROQUE_CHAVE_DE_DEMONSTRACAO"
