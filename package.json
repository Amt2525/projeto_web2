{
  "name": "solarsystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "description": "Plataforma de monitoramento de usinas fotovoltaicas (projeto acadêmico)",
  "scripts": {
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:status": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "db:generate": "pnpm --filter @solarsystem/backend db:generate",
    "db:migrate": "pnpm --filter @solarsystem/backend db:migrate",
    "db:deploy": "pnpm --filter @solarsystem/backend db:deploy",
    "dev:backend": "pnpm --filter @solarsystem/backend dev",
    "dev:simulator": "pnpm --filter @solarsystem/simulator dev",
    "dev:frontend": "pnpm --filter @solarsystem/frontend dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
